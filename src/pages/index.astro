---
import Base from '../layouts/Base.astro';
import { process, projects, services, site } from '../config/site';

const scene = (s: Record<string, number>) => JSON.stringify(s);
const marquee = services.map((s) => s.title);
---

<Base>
  <!-- Hero -->
  <section class="hero" data-hero data-scene={scene({ x: 0.5, y: 0, scale: 0.95, amp: 0.2, freq: 0.75, opacity: 1 })}>
    <div class="wrap hero__inner">
      <p class="eyebrow" data-hero-fade>{site.tagline}</p>
      <h1 class="hero__title">
        <span class="line-mask"><span class="line-inner">We design &amp; build</span></span>
        <span class="line-mask"><span class="line-inner">software that</span></span>
        <span class="line-mask"><span class="line-inner"><em>feels alive.</em></span></span>
      </h1>
      <p class="hero__lead" data-hero-fade>
        Websites, SaaS products, cloud platforms and desktop apps, designed and built end to end, with care for every
        pixel and every millisecond.
      </p>
      <div class="hero__actions" data-hero-fade>
        <a class="btn" href="#contact" data-magnetic>Start a project <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#work">See our work</a>
      </div>
    </div>
    <div class="wrap hero__foot" data-hero-fade>
      <span>Scroll to explore</span>
      <span class="hero__scroll" aria-hidden="true"></span>
      <span>Taking new projects for 2027</span>
    </div>
  </section>

  <!-- Services marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {marquee.map((m) => (
            <span>
              {m}
              <i />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Work -->
  <section class="section" id="work" data-scene={scene({ x: 0.8, y: 0.2, scale: 0.65, amp: 0.3, freq: 1.1, opacity: 0.4 })}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 data-lines>
          <span class="line-mask"><span class="line-inner">Products people</span></span>
          <span class="line-mask"><span class="line-inner">enjoy using.</span></span>
        </h2>
      </div>
      <ul class="work">
        {projects.map((p, i) => (
          <li class="work__item" data-parallax={i % 2 ? 0.18 : 0.06}>
            <a class="work__card" href="#work" data-tilt data-cursor-label="View" style={`--hue:${p.hue}`}>
              <div class="work__media" data-tilt-media>
                <div class="mock" aria-hidden="true">
                  <div class="mock__bar"><i /><i /><i /></div>
                  <div class="mock__body">
                    <span class="mock__side" />
                    <span class="mock__main">
                      <b />
                      <b />
                      <b />
                    </span>
                  </div>
                </div>
                {p.sample && <span class="work__tag">Sample</span>}
              </div>
              <div class="work__meta">
                <h3>{p.title}</h3>
                <span>{p.kind}</span>
                <span>{p.year}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services" data-scene={scene({ x: -0.75, y: -0.1, scale: 0.85, amp: 0.16, freq: 0.6, opacity: 0.4 })}>
    <div class="wrap services">
      <div class="section-head services__head">
        <p class="eyebrow">What we do</p>
        <h2 data-lines>
          <span class="line-mask"><span class="line-inner">One studio.</span></span>
          <span class="line-mask"><span class="line-inner">Every layer.</span></span>
        </h2>
        <p class="services__intro" data-reveal>
          From the first sketch to the server it runs on, we handle the whole product, so nothing gets lost between
          teams.
        </p>
      </div>
      <ol class="services__list">
        {services.map((s, i) => (
          <li class="service" data-reveal>
            <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process" data-scene={scene({ x: 0.7, y: 0.35, scale: 0.55, amp: 0.34, freq: 1.3, opacity: 0.4 })}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2 data-lines>
          <span class="line-mask"><span class="line-inner">Clear steps,</span></span>
          <span class="line-mask"><span class="line-inner">no surprises.</span></span>
        </h2>
      </div>
      <ol class="process">
        {process.map((p) => (
          <li class="process__step" data-reveal>
            <span class="process__num">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- About -->
  <section class="section about" id="about" data-scene={scene({ x: 0, y: 0, scale: 1.5, amp: 0.25, freq: 0.6, opacity: 0.22 })}>
    <div class="wrap">
      <p class="eyebrow">About</p>
      <p class="about__statement" data-reveal>
        We are a focused team of designers and engineers. You talk directly to the people who design and write your
        code, with no middlemen. We favour <em>simple, fast and well-tested</em> over clever, and we stay with you after
        launch.
      </p>
      <ul class="about__values">
        <li data-reveal><strong>Design first</strong><span>Every screen is tried on real users before it is built.</span></li>
        <li data-reveal><strong>Built to last</strong><span>Typed code, automated tests and readable docs.</span></li>
        <li data-reveal><strong>Fast by default</strong><span>Performance budgets on every page and every API.</span></li>
      </ul>
    </div>
  </section>

  <!-- Call to action -->
  <section class="section cta" id="contact" data-scene={scene({ x: 0, y: 0, scale: 1.05, amp: 0.24, freq: 0.85, opacity: 0.45 })}>
    <div class="wrap cta__inner">
      <p class="eyebrow">Have an idea?</p>
      <h2 class="cta__title" data-cta-title>Let’s build<br /><em>something bright.</em></h2>
      <a class="btn cta__btn" href="/contact/" data-magnetic>Start a project <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: 6rem;
  }
  .hero__inner {
    align-self: center;
    display: grid;
    gap: 1.75rem;
  }
  .hero__title {
    font-size: clamp(3rem, 8vw, 8rem);
  }
  em {
    font-style: normal;
    color: var(--accent);
  }
  .hero__lead {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: var(--muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .hero__scroll {
    width: 1px;
    height: 3rem;
    background: linear-gradient(var(--accent), transparent);
    animation: drip 2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% { transform: scaleY(0); opacity: 1; }
    70% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ---------- Marquee ---------- */
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1.5rem;
    background: rgba(11, 11, 15, 0.55);
    backdrop-filter: blur(6px);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee__group {
    display: flex;
  }
  .marquee span {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .marquee span:nth-child(even) {
    color: transparent;
    -webkit-text-stroke: 1px var(--text);
  }
  .marquee i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* ---------- Work ---------- */
  .work {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work__item:nth-child(even) {
    margin-top: 8rem;
  }
  .work__card {
    display: grid;
    gap: 1.25rem;
    perspective: 1000px;
  }
  .work__media {
    --gx: 50%;
    --gy: 50%;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 1.25rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at var(--gx) var(--gy), hsl(var(--hue) 90% 65% / 0.45), transparent 55%),
      linear-gradient(135deg, hsl(var(--hue) 60% 18%), hsl(calc(var(--hue) + 40) 50% 8%));
    transform-style: preserve-3d;
    will-change: transform;
  }
  .work__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(11, 11, 15, 0.7);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mock {
    width: 72%;
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    background: rgba(11, 11, 15, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
    transform: translateZ(40px);
    transition: transform 0.8s var(--ease);
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }
  .work__card:hover .mock {
    transform: translateZ(70px) scale(1.03);
  }
  .mock__bar {
    display: flex;
    gap: 0.35rem;
    padding: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .mock__bar i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .mock__body {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 0.6rem;
    padding: 0.6rem;
  }
  .mock__side {
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
  }
  .mock__main {
    display: grid;
    grid-template-rows: 1fr 1fr 2fr;
    gap: 0.5rem;
  }
  .mock__main b {
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.06);
  }
  .mock__main b:first-child {
    width: 55%;
    background: hsl(var(--hue) 90% 65% / 0.8);
  }
  .work__meta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    color: var(--muted);
  }
  .work__meta h3 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    color: var(--text);
  }
  .work__meta span:last-child {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
  }

  /* ---------- Services ---------- */
  .services {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .services__head {
    position: sticky;
    top: 7rem;
  }
  .services__intro {
    color: var(--muted);
    max-width: 36ch;
  }
  .services__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .service {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.5rem 1rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .service::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }
  .service:hover::before {
    transform: scaleX(1);
  }
  .service__num {
    font-family: var(--font-display);
    color: var(--accent);
    padding-top: 0.4rem;
  }
  .service h3 {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    transition: transform 0.6s var(--ease);
  }
  .service:hover h3 {
    transform: translateX(0.5rem);
  }
  .service p {
    grid-column: 2;
    color: var(--muted);
    max-width: 48ch;
  }

  /* ---------- Process ---------- */
  .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .process__step {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 20rem;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: rgba(19, 19, 25, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .process__step:hover {
    border-color: var(--accent);
    transform: translateY(-6px);
  }
  .process__num {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
    margin-bottom: auto;
  }
  .process__step h3 {
    font-size: 1.6rem;
    margin-top: 4rem;
  }
  .process__step p {
    color: var(--muted);
  }

  /* ---------- About ---------- */
  .about .wrap {
    display: grid;
    gap: 3rem;
  }
  .about__statement {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.2vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .about__values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 0;
    padding: 2rem 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .about__values li {
    display: grid;
    gap: 0.5rem;
  }
  .about__values strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .about__values span {
    color: var(--muted);
  }

  /* ---------- CTA ---------- */
  .cta {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    text-align: center;
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
  }
  .cta__title {
    font-size: clamp(3rem, 10vw, 10rem);
    transform-origin: center bottom;
  }
  .cta__btn {
    --h: 4.5rem;
    padding-inline: 2.5rem;
    font-size: 1.15rem;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 960px) {
    .services {
      grid-template-columns: 1fr;
    }
    .services__head {
      position: static;
    }
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .work {
      grid-template-columns: 1fr;
    }
    .work__item:nth-child(even) {
      margin-top: 0;
    }
    .process,
    .about__values {
      grid-template-columns: 1fr;
    }
    .process__step {
      min-height: 0;
    }
    .process__step h3 {
      margin-top: 1rem;
    }
    .hero__foot span:last-child {
      display: none;
    }
  }
</style>
